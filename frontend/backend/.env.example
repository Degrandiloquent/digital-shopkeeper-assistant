# Copy to .env for local development. .env is git-ignored. Never commit real secrets.
APP_ENV=development
API_PREFIX=/api/v1

# Local PostgreSQL (docker compose provides this). Render injects its own DATABASE_URL.
DATABASE_URL=postgresql://shopkeeper:shopkeeper@localhost:5432/shopkeeper

# Generate a real one:  python -c "import secrets; print(secrets.token_urlsafe(48))"
# Outside development the API refuses to start with a weak or default value.
JWT_SECRET_KEY=replace_with_a_long_random_secret
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# The frontend origin(s) allowed to call the API, comma separated, no trailing slash.
CORS_ORIGINS=http://localhost:4200

# Fictional demo data. Change the passwords for anything shared beyond a private demo.
SEED_DEMO_DATA=true
SEED_DEMO_HISTORY=true
SEED_OWNER_EMAIL=owner@alexcorner.demo
SEED_OWNER_PASSWORD=Owner#Demo2027
SEED_STAFF_EMAIL=staff@alexcorner.demo
SEED_STAFF_PASSWORD=Staff#Demo2027

# Optional tuning (defaults shown)
# LOGIN_MAX_ATTEMPTS=5
# LOGIN_WINDOW_SECONDS=600
# PUBLIC_CACHE_SECONDS=5
# DOCS_ENABLED=true
